@echo off
setlocal
REM nodejail KotH - 제출/상태조회 통합 런처 (Python 불필요)
REM 사용법:
REM   koth.bat                         -> 상태만 조회(폴링)
REM   koth.bat status                  -> 상태만 조회(폴링)
REM   koth.bat submit payload-safe.js  -> 해당 파일 제출 후 결과까지 폴링
REM   koth.bat submit payload.js TOKEN http://204.48.30.25:9000
set "PS1=%TEMP%\koth_%RANDOM%%RANDOM%.ps1"
set "B64=%TEMP%\koth_%RANDOM%%RANDOM%.b64"
> "%B64%" echo 
certutil -f -decode "%B64%" "%PS1%" >nul 2>&1
if errorlevel 1 ( echo [오류] certutil 디코드 실패 & del "%B64%" 2>nul & pause & exit /b 1 )
set "MODE=%~1"
if "%MODE%"=="" set "MODE=status"
powershell -NoProfile -ExecutionPolicy Bypass -File "%PS1%" -Mode "%MODE%" -File "%~2" -Token "%~3" -Base "%~4"
del "%B64%" "%PS1%" 2>nul
echo.
pause
