@echo off
setlocal enabledelayedexpansion
REM nodejail KotH - 서버 정찰 런처 (Python 불필요, Windows 기본 PowerShell/certutil 사용)
REM 사용법:  recon.bat [토큰] [서버URL]
REM   예)   recon.bat
REM         recon.bat YOUR_TOKEN
REM         recon.bat YOUR_TOKEN http://204.48.30.25:9000
if not "%~1"=="" set "KOTH_TOKEN=%~1"
if not "%~2"=="" set "KOTH_BASE=%~2"
set "PS1=%TEMP%\koth_recon_%RANDOM%.ps1"
set "B64=%TEMP%\koth_recon_%RANDOM%.b64"
> "%B64%" echo 
certutil -f -decode "%B64%" "%PS1%" >nul 2>&1
if errorlevel 1 (
  echo [오류] certutil 로 스크립트 디코드 실패.
  del "%B64%" 2>nul
  pause
  exit /b 1
)
powershell -NoProfile -ExecutionPolicy Bypass -File "%PS1%"
del "%B64%" "%PS1%" 2>nul
echo.
pause
