@echo off
setlocal
REM nodejail KotH - 264B(getBuiltinModule) 차등 테스트. 더블클릭 후 토큰 입력하면 끝.
REM 실패해도 활성(랭킹) 제출은 그대로 유지되어 안전.
set "PS1=%TEMP%\koth264_%RANDOM%%RANDOM%.ps1"
set "B64=%TEMP%\koth264_%RANDOM%%RANDOM%.b64"
> "%B64%" echo 
certutil -f -decode "%B64%" "%PS1%" >nul 2>&1
if errorlevel 1 ( echo [오류] certutil 디코드 실패 & del "%B64%" 2>nul & pause & exit /b 1 )
if not "%~1"=="" set "KOTH_TOKEN=%~1"
powershell -NoProfile -ExecutionPolicy Bypass -File "%PS1%"
del "%B64%" "%PS1%" 2>nul
echo.
pause
